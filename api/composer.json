{
    "name": "mhitzelberger/citations-api",
    "description": "PHP REST API for the citations management system (PDO/MariaDB).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-intl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "giorgiosironi/eris": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Citations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Citations\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "test:property": "phpunit --testsuite property",
        "test:integration": "phpunit --testsuite integration"
    }
}
