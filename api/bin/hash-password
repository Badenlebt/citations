#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * CLI tool: generate the operator password hash for the setup configuration
 * ("Einrichtungskonfiguration"), Requirement 17.6 / design "Hash-Werkzeug".
 *
 * Reads a plain-text password and prints the hash produced by
 * {@see \Citations\PasswordHasher::hash()} (password_hash with PASSWORD_DEFAULT).
 * The resulting hash goes into config.php (initialOperator.passwordHash).
 *
 * The plain text is never persisted: it is not written to a file or log, it is
 * not taken from a command-line argument (which would leak into process
 * listings and shell history), and it is held only in a local variable that is
 * overwritten before the script exits. By default the password is read
 * interactively with terminal echo disabled; with --stdin it is read from
 * standard input (one line) for scripted/piped use.
 *
 * Usage:
 *   bin/hash-password            Prompt interactively (hidden input, confirmed)
 *   bin/hash-password --stdin    Read the password from stdin (first line)
 *   bin/hash-password -h|--help  Show this help
 */

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "This tool must be run from the command line.\n");
    exit(1);
}

require __DIR__ . '/../vendor/autoload.php';

use Citations\PasswordHasher;

$args = array_slice($argv, 1);

if (in_array('-h', $args, true) || in_array('--help', $args, true)) {
    fwrite(STDOUT, usage());
    exit(0);
}

$useStdin = in_array('--stdin', $args, true);

foreach ($args as $arg) {
    if ($arg !== '--stdin') {
        fwrite(STDERR, "Unknown option: {$arg}\n\n" . usage());
        exit(2);
    }
}

$password = $useStdin ? readFromStdin() : promptHidden();

if ($password === '') {
    fwrite(STDERR, "No password provided; nothing to hash.\n");
    exit(2);
}

$hash = PasswordHasher::hash($password);

// Drop the clear text as soon as the hash exists; it is never written anywhere.
$password = str_repeat("\0", strlen($password));
unset($password);

fwrite(STDOUT, $hash . "\n");
exit(0);

/**
 * Read a single password line from standard input (for piped/scripted use).
 */
function readFromStdin(): string
{
    $line = fgets(STDIN);
    if ($line === false) {
        return '';
    }

    return rtrim($line, "\r\n");
}

/**
 * Prompt for the password interactively without echoing it to the terminal,
 * asking for confirmation to guard against typos. Falls back to a plain read
 * when the terminal cannot disable echo.
 */
function promptHidden(): string
{
    $first   = readHidden('Password: ');
    $confirm = readHidden('Confirm password: ');

    if ($first !== $confirm) {
        fwrite(STDERR, "Passwords did not match.\n");
        exit(2);
    }

    return $first;
}

/**
 * Read one line with terminal echo disabled where possible.
 */
function readHidden(string $prompt): string
{
    fwrite(STDERR, $prompt);

    $hasStty = false;
    if (function_exists('shell_exec') && DIRECTORY_SEPARATOR === '/') {
        $sttyPath = @shell_exec('command -v stty 2>/dev/null');
        $hasStty  = is_string($sttyPath) && trim($sttyPath) !== '';
    }

    if ($hasStty) {
        $previous = trim((string) shell_exec('stty -g 2>/dev/null'));
        shell_exec('stty -echo 2>/dev/null');
        $value = readFromStdin();
        if ($previous !== '') {
            shell_exec('stty ' . escapeshellarg($previous) . ' 2>/dev/null');
        } else {
            shell_exec('stty echo 2>/dev/null');
        }
        fwrite(STDERR, "\n");

        return $value;
    }

    // No stty available: read without hiding rather than failing outright.
    return readFromStdin();
}

function usage(): string
{
    $name = basename($GLOBALS['argv'][0] ?? 'hash-password');

    return <<<TXT
{$name} - generate an operator password hash for the setup configuration.

Produces the password hash (password_hash with PASSWORD_DEFAULT) to place in
config.php under initialOperator.passwordHash. The plain-text password is never
stored, logged, or passed as a command-line argument.

Usage:
  {$name}            Prompt interactively (input hidden, entered twice)
  {$name} --stdin    Read the password from the first line of stdin
  {$name} -h|--help  Show this help

Examples:
  {$name}
  printf '%s' 'my-secret' | {$name} --stdin

TXT;
}
